# =============================================================
# 个人健康管理系统 · 后端环境变量示例
# 使用方式：复制本文件为 .env 并修改为真实值
#   copy .env.example .env
# 注意：.env 不要提交到版本库
# =============================================================

# -------------------- 服务监听 --------------------
# 固定 8080，禁止使用 5000 / 5001
FLASK_HOST=0.0.0.0
FLASK_PORT=8080
FLASK_DEBUG=False

# -------------------- 数据库 --------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写你的MySQL密码
DB_NAME=health_management
DB_CHARSET=utf8mb4

# -------------------- JWT --------------------
# 生产环境务必替换为高强度随机字符串
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRE_HOURS=72

# -------------------- 对外访问地址 --------------------
# PC 端 / 小程序端统一使用的后端基础地址
API_BASE_URL=/api
STATIC_BASE_URL=/static/upload/

# -------------------- 上传 --------------------
MAX_CONTENT_LENGTH_MB=10
