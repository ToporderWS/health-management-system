# ============================================================
# management-web/ · Vue3 管理端 .gitignore
# ============================================================

# 依赖与构建产物
node_modules/
dist/

# 环境（生产/开发配置含部署地址，不入库；示例模板保留）
.env
.env.*
!.env.example

# Python 缓存（历史验证脚手架曾残留于此目录）
__pycache__/

# ★ 防止历史验证脚手架 / 临时产物再次进入产品目录
_*.py
_*.log
_verify_out/
_out/
*.log
